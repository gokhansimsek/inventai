<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Retail Analytics Report</title>
<style>
  :root {
    color-scheme: light;
    --surface: #fcfcfb;
    --surface-2: #f3f2ee;
    --border: #e6e5e0;
    --text-primary: #0b0b0b;
    --text-secondary: #52514e;
    --text-muted: #77766f;
    --accent: #2a78d6;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--surface); color: var(--text-primary);
    font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  main { max-width: 72rem; margin: 0 auto; padding: 2.5rem 1rem 4rem; }
  header h1 { margin: 0; font-size: 1.9rem; letter-spacing: -0.01em; }
  .meta { color: var(--text-secondary); margin: 0.35rem 0 0; }
  nav { margin: 1.25rem 0 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; }
  nav a { color: var(--accent); text-decoration: none; font-size: 0.93rem; }
  section { margin-top: 3rem; }
  h2 { font-size: 1.35rem; margin: 0 0 0.25rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--border); }
  h3 { font-size: 1.05rem; margin: 1.75rem 0 0.5rem; }
  p.note { color: var(--text-secondary); margin: 0.4rem 0 0.9rem; max-width: 52rem; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr)); gap: 0.75rem; margin-top: 1.5rem; }
  .tile { background: var(--surface-2); border-radius: 8px; padding: 0.85rem 1rem; }
  .tile .label { color: var(--text-secondary); font-size: 0.85rem; }
  .tile .value { font-size: 1.45rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .tile .sub { color: var(--text-muted); font-size: 0.8rem; }
  .pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: 1.5rem; }
  .pair > div { min-width: 0; }
  .scroll { overflow-x: auto; }
  table.data { border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: 0.9rem; width: 100%; }
  table.data th { font-weight: 600; color: var(--text-secondary); padding: 0.4rem 0.65rem; border-bottom: 1px solid var(--text-muted); white-space: nowrap; vertical-align: bottom; }
  table.data td { padding: 0.35rem 0.65rem; border-bottom: 1px solid var(--border); vertical-align: top; }
  table.data .num { text-align: right; white-space: nowrap; }
  table.data .text, table.data .text-long { text-align: left; }
  table.data td.text-long { min-width: 22rem; color: var(--text-secondary); }
  .empty { background: var(--surface-2); border-radius: 8px; padding: 1.25rem 1.5rem; margin-top: 1.5rem; }
  ul.assumptions li { margin: 0.3rem 0; color: var(--text-secondary); }
  code { font-size: 0.88em; background: var(--surface-2); padding: 0.05rem 0.3rem; border-radius: 4px; }
  @media print {
    nav { display: none; }
    section { break-inside: avoid-page; }
  }
</style>
{% if plotly_script %}<script>{{ plotly_script | safe }}</script>{% endif %}
</head>
<body>
<main>
<header>
  <h1>Retail Analytics Report</h1>
  <p class="meta">{{ report.selection }}</p>
  <p class="meta">Generated {{ report.generated_at.strftime("%Y-%m-%d %H:%M") }} · All amounts in TRY · Revenue after discount</p>
  <nav>
    <a href="#overview">Overview</a>
    {% if report.has_sales %}<a href="#stores">Stores</a><a href="#categories">Categories</a><a href="#trend">Trend</a><a href="#articles">Articles</a>{% endif %}
    <a href="#inventory">Inventory</a>
    <a href="#quality">Data quality</a>
    <a href="#assumptions">Assumptions</a>
  </nav>
</header>

<section id="overview">
{% if report.has_sales %}
  {% set s = report.kpis["summary"].iloc[0] %}
  {% set r = report.kpis["possible_returns"].iloc[0] %}
  <div class="tiles">
    <div class="tile"><div class="label">Revenue</div><div class="value">{{ money(s.revenue) }}</div><div class="sub">TRY after discount</div></div>
    <div class="tile"><div class="label">Gross margin</div><div class="value">{{ percent(s.gross_margin_pct) }}</div><div class="sub">{{ money(s.gross_margin) }} TRY</div></div>
    <div class="tile"><div class="label">Units sold</div><div class="value">{{ "{:,}".format(s.units | int) }}</div><div class="sub">{{ "{:,}".format(s.transactions | int) }} sale lines</div></div>
    <div class="tile"><div class="label">Possible returns</div><div class="value">{{ money(r.value) }}</div><div class="sub">TRY · {{ r.transactions | int }} lines, excluded from revenue</div></div>
  </div>
{% else %}
  <div class="empty">
    <strong>No sales match this selection.</strong>
    <p class="note">Check the store, region and date filters. Inventory and data quality results below still apply.</p>
  </div>
{% endif %}
</section>

{% if report.has_sales %}
<section id="stores">
  <h2>Revenue and margin by store</h2>
  <div class="pair">
    <div><h3>Revenue (TRY)</h3>{{ charts.revenue_by_store | safe }}</div>
    <div><h3>Gross margin %</h3>{{ charts.margin_by_store | safe }}</div>
  </div>
  <div class="scroll">{{ table(report.kpis["sales_by_store"], ["store_name", "region", "transactions", "units", "revenue", "cost", "gross_margin", "gross_margin_pct"]) | safe }}</div>
</section>

<section id="categories">
  <h2>Revenue and margin by category</h2>
  <div class="pair">
    <div><h3>Revenue (TRY)</h3>{{ charts.revenue_by_category | safe }}</div>
    <div><h3>Gross margin %</h3>{{ charts.margin_by_category | safe }}</div>
  </div>
  <div class="scroll">{{ table(report.kpis["sales_by_category"], ["category", "transactions", "units", "revenue", "cost", "gross_margin", "gross_margin_pct"]) | safe }}</div>
</section>

<section id="trend">
  <h2>Revenue over time</h2>
  <h3>Daily revenue (TRY)</h3>
  {{ charts.revenue_by_day | safe }}
  <div class="pair">
    <div><h3>By week (Monday to Sunday)</h3><p class="note">The first and last weeks can be partial: the data starts and ends mid-week.</p><div class="scroll">{{ table(report.kpis["sales_by_week"], ["week", "units", "revenue", "gross_margin_pct"]) | safe }}</div></div>
    <div><h3>By month</h3><div class="scroll">{{ table(report.kpis["sales_by_month"], ["month", "units", "revenue", "gross_margin", "gross_margin_pct"]) | safe }}</div></div>
  </div>
</section>

<section id="articles">
  <h2>Top and bottom {{ report.top_n }} articles</h2>
  <p class="note">Margin % lists include only articles with at least {{ report.min_units_for_margin_pct }} units sold, so a handful of sales cannot dominate them.</p>
  {% set article_columns = ["rank", "article_id", "article_name", "category", "units", "revenue", "gross_margin", "gross_margin_pct"] %}
  {% for measure, title in [("revenue", "revenue"), ("margin_try", "gross margin (TRY)"), ("margin_pct", "gross margin %")] %}
  <h3>Top by {{ title }}</h3><div class="scroll">{{ table(report.kpis["top_by_" ~ measure], article_columns) | safe }}</div>
  <h3>Bottom by {{ title }}</h3><div class="scroll">{{ table(report.kpis["bottom_by_" ~ measure], article_columns) | safe }}</div>
  {% endfor %}
</section>
{% endif %}

<section id="inventory">
  <h2>Inventory turnover</h2>
  {% set turnover = report.kpis["inventory_turnover_by_store"] %}
  {% if turnover.empty %}
  <div class="empty"><strong>Not available:</strong> the selected date range does not contain a full inventory week (Monday to Sunday).</div>
  {% else %}
  <p class="note">
    Cost of goods sold ÷ average weekly inventory value, both at purchase price, for the period
    {{ turnover_period }}
    ({{ report.turnover_weeks | length }} week{{ "s" if report.turnover_weeks | length != 1 }}). Not annualised.
    Only inventory weeks lying entirely inside the date range are used. The inventory file samples different
    articles each week, so turnover describes the sampled articles.
  </p>
  {% if charts.turnover_by_store %}{{ charts.turnover_by_store | safe }}{% endif %}
  <div class="scroll">{{ table(turnover, ["store_name", "region", "weeks", "cogs", "avg_inventory_value", "turnover"]) | safe }}</div>

  <h3>Sales in the inventory file vs transactions</h3>
  <p class="note">
    Units sold according to the inventory file, compared with units in the transactions for the same
    store, article and week. The two files do not reconcile, which is why turnover uses the inventory file alone.
  </p>
  <div class="scroll">{{ table(report.kpis["sales_vs_inventory"]) | safe }}</div>
  {% endif %}
</section>

<section id="quality">
  <h2>Data quality</h2>
  <p class="note">
    Validation runs on the full input files before any filter, so this section is the same for every selection.
    Every row is accounted for: raw = clean + quarantined. Quarantined rows are in <code>quarantine/</code> and
    flagged rows in <code>issues/</code>, each with a reason.
  </p>
  <h3>Rows processed</h3>
  <div class="scroll">{{ table(report.row_counts) | safe }}</div>
  <h3>What the checks found</h3>
  <div class="scroll">{{ table(findings, ["rule_id", "severity", "fixed", "rejected", "flagged", "description"]) | safe }}</div>
  <p class="note">{{ quiet_checks }} further checks ran and found nothing; see <code>data_quality.csv</code> for all of them.</p>
</section>

<section id="assumptions">
  <h2>Assumptions</h2>
  <ul class="assumptions">
    <li>Prices in KRS (kuruş) are converted to TRY at 100 KRS = 1 TRY.</li>
    <li>Cost uses each article's current purchase price; the data has no cost history.</li>
    <li>Negative quantities are excluded from revenue: nothing links them to an original sale. Their value is shown as possible returns.</li>
    <li>Transactions dated in the future are given the date of the preceding transaction id; ids follow date order everywhere else in the data.</li>
    <li>Sales at stores missing from the store list are excluded.</li>
    <li>Regions are those in the store file (e.g. Marmara), not the North/South/East/West/Central listed in the brief.</li>
  </ul>
</section>
</main>
{% if plotly_script %}
<script>
  // Charts are drawn while the page is still laying out; size them to their final columns.
  window.addEventListener("load", () => {
    document.querySelectorAll(".js-plotly-plot").forEach((chart) => Plotly.Plots.resize(chart));
  });
</script>
{% endif %}
</body>
</html>
